# ============================================================================
# World Cup 2026 Predictor — configuration  [CONFIG]
# Copy to .env and fill in real values. Admin can edit leagueCode / lockAt /
# scoring live from the Admin screen too (Setting rows override env).
# ============================================================================

# --- Required -----------------------------------------------------------------

# SQLite database file. Inside Docker this is overridden to file:/data/app.db
# (a named volume). For local dev keep the prisma-relative path.
DATABASE_URL="file:./dev.db"

# Secret for signing session cookies. Generate one:  openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_RANDOM_64_HEX_CHARS"

# The join code friends type to enter your league.
LEAGUE_CODE="VAMOS2026"

# Recovery token for the seeded admin account. Generate one (openssl rand -hex 16),
# then log in once at https://your-domain/me/<this value>.
ADMIN_RECOVERY_TOKEN="CHANGE_ME_ADMIN_TOKEN"

# The single global lock: all predictions freeze at this instant (UTC).
# Default = 30 minutes before the opening match (Mexico v South Africa,
# kickoff 2026-06-11 19:00 UTC).
PREDICTION_LOCK_AT="2026-06-11T18:30:00Z"

# Public URL of the app (used to build recovery links).
APP_URL="https://predictions.example.com"

# Domain Caddy should serve (must have an A record → this server's IP).
DOMAIN="predictions.example.com"

# --- Results source (no API key needed) ----------------------------------------

# openfootball public-domain JSON — seeding AND result updates. No key.
OPENFOOTBALL_URL="https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.json"

# How often the app polls for results (minutes). No real-time requirement.
RESULTS_POLL_MINUTES="20"

# --- Live scores (optional, recommended during the tournament) -----------------

# football-data.org free tier — with a real key set, the sync layers live
# in-play scores and fast full-time results on top of openfootball, and the
# poller tightens to LIVE_POLL_SECONDS while a match is in play.
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_API_KEY="YOUR_FOOTBALL_DATA_ORG_API_KEY_HERE"

# Poll cadence (seconds) while a match is live and the key above is set.
LIVE_POLL_SECONDS="90"

# --- Optional fallback APIs (only if you switch off openfootball, PLAN.MD §8) --

# API-Football (api-sports.io) free tier — placeholder, unused by default.
API_FOOTBALL_KEY="YOUR_API_SPORTS_IO_KEY_HERE"
